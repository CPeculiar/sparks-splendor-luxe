# Frontend Production Environment Template
# Copy to .env.production or set in Vercel Dashboard

# ──────────────────────────────────────────────────────────
# API CONFIGURATION
# ──────────────────────────────────────────────────────────
# Backend API URL (update with your Render backend URL)
VITE_API_BASE_URL=https://sparks-splendor-backend.onrender.com

# ──────────────────────────────────────────────────────────
# CLOUDINARY CONFIGURATION
# ──────────────────────────────────────────────────────────
# Get from Cloudinary Dashboard → Settings → API Keys
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sparks-splendor-production

# ──────────────────────────────────────────────────────────
# PAYMENT GATEWAY (Paystack)
# ──────────────────────────────────────────────────────────
# Live public key from Paystack
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# ──────────────────────────────────────────────────────────
# GOOGLE OAUTH
# ──────────────────────────────────────────────────────────
# Get from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ──────────────────────────────────────────────────────────
# FEATURES
# ──────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT_SUPPORT=false
VITE_DEBUG_MODE=false
